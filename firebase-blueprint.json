    "debts": {
      "title": "Debt",
      "description": "Debt and loan records (Pawna / Dena)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "personName": { "type": "string" },
        "amount": { "type": "number" },
        "paidAmount": { "type": "number" },
